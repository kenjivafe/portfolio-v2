# --- Shopify Storefront API (headless commerce) -----------------------------
# Cart, checkout, payments, tax and shipping stay on Shopify. This app only
# reads the catalogue and builds carts against it.

# Your myshopify domain, with or without the scheme.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps ->
# create an app -> Storefront API access token.
# Scopes needed: unauthenticated_read_product_listings,
#                unauthenticated_read_product_inventory,
#                unauthenticated_write_checkouts,
#                unauthenticated_read_checkouts
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Pin the Storefront API version; defaults to 2026-07.
# SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Signing secret for the products/* and collections/* webhooks that point at
# /api/revalidate. Without it that route refuses to revalidate.
SHOPIFY_WEBHOOK_SECRET=
